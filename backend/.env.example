# Copy this file to `backend/.env` and fill in your own credentials.
# `.env` is git-ignored and must never be committed.

# --- HubSpot (required for Part 1 & 2) ---------------------------------------
# HubSpot app creation is now CLI-driven (browser-only "Legacy App" creation is
# disabled). See the README "Create a HubSpot app" section for the full
# `hs project create` / `app-hsmeta.json` / `hs project upload` steps. Use
# --distribution private to skip the marketplace acceptable-use-policy gate.
# Required scopes: oauth, crm.objects.contacts.read, crm.objects.companies.read,
# crm.objects.deals.read. Redirect URL:
#   http://localhost:8000/integrations/hubspot/oauth2callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Airtable (optional) -----------------------------------------------------
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

# --- Notion (optional) -------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Infrastructure ----------------------------------------------------------
REDIS_HOST=localhost
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
